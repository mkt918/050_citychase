{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "citychase-online",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "anonymous": true
    }
  }
}
